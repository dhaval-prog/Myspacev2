{
  "expo": {
    "name": "MySpace",
    "slug": "myspace-v2",
    "version": "1.0.0",
    "scheme": "myspace",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#C3EA4F",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["upi", "tez", "phonepe", "paytmmp", "bhim"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C3EA4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "manifestQueries": {
        "intent": [
          {
            "action": "android.intent.action.VIEW",
            "data": { "scheme": "upi" }
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#C3EA4F"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MySpace uses your camera to scan a card's join QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MySpace uses your photos to read QR codes and share photos in chat."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MySpace uses your location to share it in a chat message."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#C3EA4F"
        }
      ]
    ]
  }
}
