{
  "expo": {
    "name": "MySpace",
    "slug": "myspace-v2",
    "version": "1.0.0",
    "scheme": "myspace",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#C3EA4F",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C3EA4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MySpace uses your camera to scan a card's join QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MySpace uses your photos to read a join QR code from an image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#C3EA4F"
        }
      ]
    ]
  }
}
