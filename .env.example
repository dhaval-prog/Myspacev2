# Supabase project (Project Settings → API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://fdjeafihwwoeqdcnqhjd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox (Throw's map on web) — console.mapbox.com → Tokens / Studio → your style's "Share" URL
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_STYLE_URL=

# Weather (Throw's rain effect, see src/services/weatherService.ts) — Open-Meteo needs no API key
# at all, so this is only worth setting to point at a self-hosted instance; leave unset otherwise.
EXPO_PUBLIC_OPEN_METEO_BASE_URL=
